# S.C.O.U.T. shore station — reads the ESP32-S3 LoRa receiver over USB and writes daily CSVs.
#
# Install on the Linux computer the S3 is plugged into (a Raspberry Pi works):
#   sudo cp shore/deploy/scout-shore.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scout-shore
#   journalctl -u scout-shore -f
#
# Assumes the repo is cloned at /home/pi/S.C.O.U.T. and runs as the `pi` user. Adjust both
# below if yours differs. BEFORE enable: run `ls /dev/serial/by-id/` and replace the
# REPLACE_ME path in ExecStart with the S3's stable name. Do not use /dev/ttyACM0 — it
# renumbers when another USB device is plugged in. This unit only receives LoRa frames into
# data-live/; run sync_console.py (or scout-shore-sync.timer) separately to talk to the console.
# See shore/README.md and docs/engineering/first-boot-checklist.md.

[Unit]
Description=S.C.O.U.T. shore station (LoRa receiver)
Documentation=https://github.com/David-Chousal/S.C.O.U.T./blob/main/shore/README.md
# Only ordering, not a dependency: the receiver writes to a local disk and does not need the
# network. Losing the uplink must never stop us recording what the buoy sent.
After=network.target

# Never give up restarting. Must live in [Unit]: systemd moved this out of [Service] in v230
# and silently ignores it there, which would leave the unit dead after 5 restarts in 10s —
# exactly what happens while the S3 is unplugged or still enumerating at boot.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
# Serial ports belong to the dialout group on Debian and Raspberry Pi OS.
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/S.C.O.U.T./shore
ExecStart=/usr/bin/python3 scripts/run_receiver.py --link serial --serial /dev/serial/by-id/REPLACE_ME --out data-live

# Always come back. An unattended station on a coastline is not going to be restarted by hand,
# and the buoy transmits blind — if nothing is listening, neither end raises an alarm.
Restart=always
RestartSec=10

# SIGTERM is what the service turns into a clean stop; give it room to finish the write.
KillSignal=SIGTERM
TimeoutStopSec=30

# Unbuffered, so `journalctl -f` shows lines as they happen rather than in 8 KB blocks.
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Modest hardening. Not a sandbox — the process needs the S3's serial port and write access
# to the repo's data-live/ directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
