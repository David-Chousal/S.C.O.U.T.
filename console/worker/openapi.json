{
  "openapi": "3.0.3",
  "info": {
    "title": "S.C.O.U.T. Console API",
    "version": "1.0.0",
    "description": "Read the buoys, their readings, heat stress and settings; request a transmit count. Make a personal token on the console's Developer page and send it as `Authorization: Bearer sct_…`. A token acts with its owner's current role, limited by its scopes."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "token": []
    }
  ],
  "components": {
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer",
        "description": "A personal API token (sct_…)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Buoy": {
        "type": "object",
        "properties": {
          "buoy_id": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "tx_count_requested": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 3
          },
          "tx_count_reported": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 3
          },
          "reported_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix ms of the newest row's own timestamp"
          },
          "last_seen_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix ms the newest row arrived"
          },
          "clock_lost": {
            "type": "integer",
            "description": "1 while the newest row carried RTC_LOST"
          },
          "state": {
            "type": "string",
            "enum": [
              "confirmed",
              "default",
              "pending",
              "unreported",
              "rejected"
            ]
          },
          "settings_requested": {
            "type": "object",
            "description": "Each remote setting's requested value, or null for the firmware default",
            "additionalProperties": {
              "type": "integer",
              "nullable": true
            }
          },
          "settings_wanted": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "The snapshot the buoy should run, in setting-ID order"
          },
          "settings_digest_wanted": {
            "type": "string",
            "pattern": "^[0-9a-f]{4}$"
          },
          "settings_digest_reported": {
            "type": "string",
            "nullable": true,
            "pattern": "^[0-9a-f]{4}$",
            "description": "From the newest v5 packet"
          },
          "settings_state": {
            "type": "string",
            "enum": [
              "confirmed",
              "default",
              "pending",
              "unreported",
              "rejected"
            ]
          }
        }
      },
      "Reading": {
        "type": "object",
        "description": "One schema row as the shore station sent it (shore/scout_shore/schema.py); every value is a string, blank when not measured.",
        "additionalProperties": {
          "type": "string"
        },
        "properties": {
          "buoy_id": {
            "type": "string"
          },
          "timestamp_utc": {
            "type": "string"
          },
          "record_seq": {
            "type": "string"
          },
          "temp_c": {
            "type": "string"
          },
          "turbidity_fau": {
            "type": "string"
          },
          "battery_v": {
            "type": "string"
          },
          "internal_humidity_pct": {
            "type": "string"
          },
          "flags": {
            "type": "string"
          },
          "tx_count": {
            "type": "string"
          }
        }
      },
      "FirmwareJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "buoy_id": {
            "type": "integer"
          },
          "version": {
            "type": "string",
            "example": "v0.2.1"
          },
          "size": {
            "type": "integer",
            "description": "Bundle bytes"
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 of the image, hex"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "staged",
              "offering",
              "transferring",
              "trial",
              "confirmed",
              "rolled_back",
              "rejected",
              "canceled"
            ]
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          }
        }
      },
      "HeatStressDay": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "example": "2027-04-02",
            "description": "UTC calendar day"
          },
          "sst": {
            "type": "number",
            "nullable": true,
            "description": "Daily mean of trusted readings, °C; null when the day had too few"
          },
          "hotspot": {
            "type": "number",
            "nullable": true,
            "description": "max(0, sst − MMM), °C"
          },
          "dhw": {
            "type": "number",
            "description": "Degree Heating Weeks, °C-weeks"
          },
          "alert": {
            "type": "string",
            "enum": [
              "No Stress",
              "Bleaching Watch",
              "Bleaching Warning",
              "Alert Level 1",
              "Alert Level 2",
              "Alert Level 3",
              "Alert Level 4",
              "Alert Level 5"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7,
            "description": "Index of alert in alert_levels"
          },
          "window_coverage": {
            "type": "number",
            "description": "Share of the 84-day window with a daily mean, 0–1"
          }
        }
      },
      "BuoyHeatStress": {
        "type": "object",
        "properties": {
          "buoy_id": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "mmm": {
            "type": "object",
            "nullable": true,
            "properties": {
              "value_c": {
                "type": "number"
              },
              "source": {
                "type": "string",
                "enum": [
                  "noaa_crw_5km",
                  "manual"
                ]
              },
              "latitude": {
                "type": "number",
                "nullable": true
              },
              "longitude": {
                "type": "number",
                "nullable": true
              },
              "cell_latitude": {
                "type": "number",
                "nullable": true,
                "description": "CRW 5 km cell the MMM came from"
              },
              "cell_longitude": {
                "type": "number",
                "nullable": true
              },
              "set_by": {
                "type": "string",
                "nullable": true
              },
              "set_at": {
                "type": "integer",
                "nullable": true,
                "description": "Unix ms"
              }
            }
          },
          "threshold_c": {
            "type": "number",
            "nullable": true,
            "description": "Bleaching threshold, MMM + 1 °C"
          },
          "samples_per_day": {
            "type": "integer",
            "description": "Readings a full day should have (the buoy's transmit count); half are needed for a daily mean"
          },
          "current": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HeatStressDay"
              }
            ],
            "nullable": true,
            "description": "The newest day with a daily mean, plus days_old"
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HeatStressDay"
            }
          },
          "summary": {
            "type": "object",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "HeatStressView": {
        "type": "object",
        "properties": {
          "window_days": {
            "type": "integer",
            "example": 84
          },
          "alert_levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generated_at": {
            "type": "string"
          },
          "buoys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BuoyHeatStress"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/buoys": {
      "get": {
        "summary": "Every buoy, its transmit count and freshness",
        "description": "Scope: read:telemetry.",
        "responses": {
          "200": {
            "description": "Buoys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "buoys": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Buoy"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/buoys/{buoy_id}/readings": {
      "get": {
        "summary": "A buoy's readings, newest first",
        "description": "Scope: read:telemetry.",
        "parameters": [
          {
            "name": "buoy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2026-10-30T00:00:00Z"
            },
            "description": "Earliest timestamp_utc, inclusive"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2026-10-31T00:00:00Z"
            },
            "description": "Latest timestamp_utc, inclusive"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Readings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "readings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Reading"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "summary": "Each buoy and the firmware's settings (from config.h)",
        "description": "Scope: read:telemetry.",
        "responses": {
          "200": {
            "description": "Settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "buoys": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Buoy"
                      }
                    },
                    "firmware": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/buoys/{buoy_id}/tx-count": {
      "post": {
        "summary": "Request a daily transmit count (1-3)",
        "description": "Scope: write:settings, and the token's owner must be a member or admin. Stays pending until the buoy reports it.",
        "parameters": [
          {
            "name": "buoy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tx_count"
                ],
                "properties": {
                  "tx_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Requested"
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This file",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3 document"
          }
        }
      }
    },
    "/buoys/{buoy_id}/settings": {
      "post": {
        "summary": "Request remote settings",
        "description": "Scope: write:settings, and the token's owner must be a member or admin. Send any of the remote settings; the buoy's whole snapshot (defaults overlaid with every request) must be one the buoy would accept, or nothing is stored (critical_mv at least 50 mV under conserve_mv). Pending until the buoy's v5 packets report the same settings digest.",
        "parameters": [
          {
            "name": "buoy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "settings"
                ],
                "properties": {
                  "settings": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "tx_count": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Transmits a day. How many of the three daily slots send a packet. Default 3; null withdraws a request.",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "slot_phase_h": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Slot phase (h). Moves every transmit slot and recording this many hours later. Default 0; null withdraws a request.",
                        "minimum": 0,
                        "maximum": 7
                      },
                      "sample_interval_min": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Reading interval (min). Minutes between sensor readings. Default 30; null withdraws a request.",
                        "enum": [
                          15,
                          30,
                          60,
                          null
                        ]
                      },
                      "audio_clip_s": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Hydrophone clip (s). Length of each recording; 0 turns recording off. Default 60; null withdraws a request.",
                        "enum": [
                          0,
                          15,
                          30,
                          60,
                          null
                        ]
                      },
                      "conserve_mv": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Conserve below (mV). Below this battery voltage the buoy skips audio and sends less. Default 3200; null withdraws a request.",
                        "minimum": 3000,
                        "maximum": 3600,
                        "multipleOf": 10
                      },
                      "critical_mv": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Critical below (mV). Below this it only logs temperature. At least 50 mV under conserve. Default 3100; null withdraws a request.",
                        "minimum": 2900,
                        "maximum": 3500,
                        "multipleOf": 10
                      },
                      "conserve_every": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Conserve: send every (slot). In conserve, transmit in every Nth used slot. Default 3; null withdraws a request.",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "humidity_alert_pct": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Housing humidity alert (%RH). Rows at or above it carry HUMIDITY_HIGH. Default 70; null withdraws a request.",
                        "minimum": 40,
                        "maximum": 95
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Requested"
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/buoys/{buoy_id}/firmware": {
      "get": {
        "summary": "List firmware jobs for a buoy",
        "description": "Scope: read:telemetry. Newest first, at most 50.",
        "parameters": [
          {
            "name": "buoy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FirmwareJob"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload a signed firmware bundle (.scoutfw)",
        "description": "Scope: write:firmware, and the token's owner must be an admin. The body is the bundle written by firmware/tools/ota_release.py sign. The console checks its layout, size (image at most 224 KB) and the image's SHA-256, never the signature: the shore station and the buoy verify that. The version must be higher than any version already sent to the buoy. A job the buoy has not accepted yet is replaced; an upload during a transfer is refused.",
        "parameters": [
          {
            "name": "buoy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored as pending",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/FirmwareJob"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/firmware/{job_id}/cancel": {
      "post": {
        "summary": "Cancel a firmware job",
        "description": "Scope: write:firmware, and the token's owner must be an admin. Only a job the buoy has not accepted (pending, staged or offering).",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canceled"
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/heat-stress": {
      "get": {
        "summary": "Heat stress (DHW and CRW bleaching alert) for every connected buoy",
        "description": "Scope: read:telemetry. NOAA Coral Reef Watch thermal stress from the buoy's in-water temperature (ADR-0017): the daily mean of trusted readings, HotSpot = daily mean − MMM, Degree Heating Weeks over 84 days and the CRW alert level. `series` covers the last 84 days; a buoy with no MMM has `mmm: null` and a `note`.",
        "responses": {
          "200": {
            "description": "Heat stress",
