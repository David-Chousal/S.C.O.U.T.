# ---------------------------------------------------------------------------
firmware/.pio/
firmware/build/
*.elf
*.hex
*.bin

# KiCad / EDA backups and autosaves
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.lck

