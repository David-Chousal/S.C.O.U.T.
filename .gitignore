# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# The raw hydrophone archive is ~7 GB. It is excluded from git; see README.md
# for how to obtain the full dataset from its original authors.

/data/
analytics/data/raw_audio/
analytics/data/raw_audio_site_b/

# Track exactly one longitudinal session so the pipeline is runnable on clone.
analytics/data/longitudinal/*
!analytics/data/longitudinal/201708_20170801/
!analytics/data/longitudinal/201708_20170801/**

# Stray audio outside the designated data directories
*.wav
!analytics/data/longitudinal/201708_20170801/*.wav

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
